# CodeIgniter 4 .gitignore
# ------------------------

# Composer
/vendor/

# User-specific Environment
.env
.phpunit.result.cache

# CodeIgniter 4 Writable directory
# We ignore everything inside but keep the directory (standard CI4)
/writable/*
!/writable/index.html
!/writable/.htaccess
!/writable/cache/
!/writable/cache/.gitkeep
!/writable/logs/
!/writable/logs/.gitkeep
!/writable/session/
!/writable/session/.gitkeep
!/writable/uploads/
!/writable/uploads/.gitkeep
!/writable/debugbar/
!/writable/debugbar/.gitkeep

# Public uploads (if you want to keep them on local only)
# /public/uploads/*
# !/public/uploads/index.html

# IDE Specific
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS specific files
.DS_Store
Thumbs.db

# Log files
*.log
fix_db.php
hard_reset_db.php
public/uploads/

# Scratch / Temporary Scripts (Testing Only)
scratch/
project.zip
/build/
/docs/

# ============================================================
# SECURITY — Jangan pernah commit file-file ini ke Git!
# ============================================================

# Database dumps (BERBAHAYA — berisi data user nyata)
*.sql
*.sql.gz
*.dump

# File arsip project
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# File backup
*.bak
*.backup
*.old

# File kunci dan sertifikat
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt